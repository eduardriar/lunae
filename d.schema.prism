generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ReservationState {
  pending
  confirmed
  cancelled
  completed
}

model Reservation {
  id                    String           @id @default(cuid())
  name                  String
  email                 String?
  phone                 String
  serviceId             String           @map("service_id")
  service               Service          @relation(fields: [serviceId], references: [id])
  duration              Int
  date                  DateTime         @db.Date
  hour                  String
  price                 Int
  notes                 String?
  state                 ReservationState @default(pending)
  whatsappMessageId     String?          @map("whatsapp_message_id")
  googleCalendarEventId String?          @map("google_calendar_event_id")
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt      @map("updated_at")

  @@map("reservations")
}

model Service {
  id              String        @id @default(cuid())
  name            String
  duration        Int
  price           Int
  additionalPrice Int           @map("additional_price")
  description     String
  state           Boolean       @default(true)
  reservations    Reservation[]

  @@map("services")
}
