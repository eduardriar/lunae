# Database (Supabase Postgres)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public"

# Google Calendar
GOOGLE_CALENDAR_ID="primary"
# In production: full JSON contents of the service account key as a string.
# In dev: leave unset to use the local keys/*.json file fallback.
GOOGLE_SERVICE_ACCOUNT_KEY=""

# WhatsApp Business Cloud API (Meta)
WHATSAPP_API_VERSION="v21.0"
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_ACCESS_TOKEN=""

# Verification token (you choose this string). Must match what you enter in
# Meta Dashboard > WhatsApp > Configuration > Webhook > Verify Token.
WHATSAPP_VERIFY_TOKEN=""

# App secret from Meta Dashboard > App Settings > Basic > App Secret.
# Used to verify the X-Hub-Signature-256 header on incoming webhooks.
WHATSAPP_APP_SECRET=""
